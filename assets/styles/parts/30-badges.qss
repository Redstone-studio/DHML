/* ============================ 提示条 / 徽章 ============================ */

#WarningBanner {
    background-color: @warn_bg@;
    border: 1px solid @warn_border@;
    border-radius: 8px;
    color: @warn@;
    padding: 9px 12px;
    font-size: 12px;
}

#ErrorBanner {
    background-color: @danger_bg@;
    border: 1px solid @danger_border_strong@;
    border-radius: 8px;
    color: @danger@;
    padding: 9px 12px;
    font-size: 12px;
}

#Badge {
    background-color: @bg_control@;
    border: 1px solid @border_control@;
    border-radius: 6px;
    color: @text_dim@;
    padding: 3px 9px;
    font-size: 12px;
}
#BadgeAccent {
    background-color: @accent_bg@;
    border: 1px solid @accent_border@;
    border-radius: 6px;
    color: @accent_text@;
    padding: 3px 9px;
    font-size: 12px;
}
#BadgeWarn {
    background-color: @warn_bg@;
    border: 1px solid @warn_border@;
    border-radius: 6px;
    color: @warn@;
    padding: 3px 9px;
    font-size: 12px;
}

/* ==================== 版本列表（卡片式，参考 PCL2） ====================
   从 QTableWidget 换过来的原因：表格选中一行时，每个单元格各画各的选中背景，
   看起来高亮被切成好几段。卡片列表整行连续高亮，还能一行放"名称 + 元信息"。 */

#VersionList {
    background-color: transparent;
    border: none;
    outline: none;
}
/* 关键：item 不能留 margin / 圆角断层，否则高亮又会断开 */
#VersionList::item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    margin: 2px 0;
    padding: 0;
}
#VersionList::item:hover {
    background-color: @bg_elevated@;
}
#VersionList::item:selected {
    background-color: @accent_bg@;
    border-color: @accent_border@;
}

#VersionGroupTitle {
    color: @text_faint@;
    font-size: 12px;
    font-weight: bold;
    padding: 14px 0 6px 10px;
}
#VersionRowName {
    color: @text@;
    font-size: 14px;
    font-weight: bold;
}
#VersionRowMeta {
    color: @text_faint@;
    font-size: 12px;
}

/* 有版本类型图（草方块/圆石/铁砧…）时的方块：透明底，让图自己说话 */
#BadgeIcon {
    background-color: transparent;
    border: none;
}

#BadgeVanilla {
    background-color: @accent_bg@;
    border: 1px solid @accent_border@;
    border-radius: 10px;
    color: @accent_text@;
    font-size: 13px;
    font-weight: bold;
}
#BadgeLoader {
    background-color: @warn_bg@;
    border: 1px solid @warn_border@;
    border-radius: 10px;
    color: @warn@;
    font-size: 13px;
    font-weight: bold;
}
#BadgePack {
    background-color: @pack_bg@;
    border: 1px solid @pack_border@;
    border-radius: 10px;
    color: @pack_text@;
    font-size: 13px;
    font-weight: bold;
}

/* ==================== 账户列表（和版本列表同款卡片行） ==================== */

#AccountList {
    background-color: transparent;
    border: none;
    outline: none;
}
#AccountList::item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    margin: 2px 0;
    padding: 0;
}
/* 账户列表的"选中"用中性灰，绿色专门留给"当前档案"。
   否则绿色填充（选中）比那根细竖条（当前）显眼得多，
   会让人误以为选中的那行才是当前档案。
   （版本页没有"当前"这个概念，所以那边选中有权用绿色。） */
#AccountList::item:hover {
    background-color: @bg_elevated@;
}
#AccountList::item:selected {
    background-color: @bg_hover@;
    border-color: @border_selected@;
}
#AccountRowName {
    color: @text@;
    font-size: 14px;
    font-weight: bold;
}
/* 当前档案：名字用强调色，配左边那根竖条。
   不用右侧徽章 —— 徽章飘在行尾离内容很远，看着很散。 */
#AccountRowNameCurrent {
    color: @accent@;
    font-size: 14px;
    font-weight: bold;
}
#AccountRowMeta {
    color: @text_faint@;
    font-size: 12px;
}
/* 当前档案的左侧竖条。非当前的行也用同样宽度占位（只是透明），
   这样两种行的文字起始位置能对齐。 */
#AccountRowAccent {
    background-color: @accent@;
    border-radius: 2px;
}
#AccountRowAccentOff {
    background-color: transparent;
}

/* ==================== 可滚动页面 ====================
   设置页的内容比窗口高时必须有滚动条，否则卡片会被压扁、底部被切掉。
   QScrollArea 是 QFrame，会继承全局 QWidget 的底色，这里设成透明，
   让它露出页面自己的背景。 */

QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* 游戏目录列表里的一行：名字正常大小，**路径用更小的字**（路径很长，
   跟名字一样大会把名字压下去）。结构见 versions_page._make_dir_row() */
#DirRowName {
    color: @text@;
    font-size: 13px;
    font-weight: bold;
}
#DirRowPath {
    color: @text_faint@;
    font-size: 11px;
}
/* 游戏目录列表里那一行的容器。⚠️ 它盖在 item 的选中底色上面，
   背景必须透明，不然选中高亮会被这层糊掉（只剩文字没有高亮）。
   QListWidget::setItemWidget 挂上去的控件都容易踩这个。 */
#DirRow, #DirRow QLabel {
    background-color: transparent;
}
/* 下载页左侧的分组标题（版本 / 社区资源 / 安装包）。
   ⚠️ 字号必须写在 QSS 里：全局 `QWidget { font-size: 14px }` 会盖掉
   代码里 setFont() 设的值，所以标题大不大完全由这条决定（ID 选择器优先级更高）。
   背景要透明——它是 setItemWidget 挂上去的，不透明会盖住 item 自己的底色。 */
#DownloadNavGroup {
    background-color: transparent;
    color: @text_dim@;
    font-size: 17px;
    font-weight: bold;
}
/* 折叠组（下载页第一页的「正式版 103」、安装选项页的「Forge 3」都用它）。
   ⚠️ 字号必须写在这儿（QSS 字号优先于代码 setFont）。
   ⚠️ **标题栏是有框的、展开出来的行是扁平的**（用户 2026-09 明确要求）：
   标题做成卡片（跟 `#ModCard` / `#ModVersionCard` 一个观感，一致），
   组内的版本行**不再各自套一个框** —— 一行一个框的话，
   以后做"展开时逐行滑入"的动画会很别扭（每个框都在自己动），
   而且真正要点的目标是那一行，不是框。
   ⚠️ #CollapsibleBody / #RemoteVersionRow 的底色必须透明：
   不透明会盖住卡片底色，而且扁平行看着像"没对齐的框"。 */
#CollapsibleHeader {
    background-color: @bg_card@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 11px 14px;
    text-align: left;
    color: @text@;
    font-size: 15px;
    font-weight: bold;
}
#CollapsibleHeader:hover {
    background-color: @bg_elevated@;
    border-color: @accent@;
}
/* ⚠️ 框里那个按钮只是"可点区域"，**不要它自己的边框/底色**：
   框和悬停效果由外面的 #CollapsibleHeader 负责。
   （选择器写 `#CollapsibleHeader QPushButton` 是为了压过 10-buttons.qss
   里 `QPushButton` 的基础样式 —— 单写 `#CollapsibleHeaderButton` 的话
   按钮还是会有自己的底和边框。） */
#CollapsibleHeader QPushButton {
    background-color: transparent;
    border: none;
    padding: 0;
    text-align: left;
    color: @text@;
    font-size: 15px;
    font-weight: bold;
}
#CollapsibleHeader QPushButton:hover {
    color: @accent@;
}
/* 标题右边的副标题（"最新版 0.19.5（共 253 个）"那种）。
   比标题小、比标题淡 —— 它是补充信息，不该跟标题抢注意力。 */
#CollapsibleHeaderNote {
    background-color: transparent;
    color: @text_faint@;
    font-size: 12px;
    font-weight: normal;
}
/* 标题右边的**小动作按钮**（现在只有安装选项页的「取消选择」用它）。
   ⚠️ 要写在 `#CollapsibleHeader QPushButton` **后面**压过它：那条把框里所有
   按钮都拍扁成"透明无边框"了，小按钮得自己把边框和字号要回来。
   ⚠️ 它是"标题里的一个次要动作"，字号跟副标题一样大就够了 ——
   做成跟标题一样大反而会抢注意力。 */
#CollapsibleHeader QPushButton#CollapsibleAction {
    background-color: transparent;
    border: 1px solid @accent_border@;
    border-radius: 6px;
    padding: 2px 8px;
    color: @accent_text@;
    font-size: 12px;
    font-weight: normal;
}
#CollapsibleHeader QPushButton#CollapsibleAction:hover {
    background-color: @accent_bg@;
    border-color: @accent@;
    color: @accent_text_strong@;
}
/* 锁着的组（加载器互斥：现在装的是别家）。
   ⚠️ **悬停效果要一起撤掉**：它现在真的点不动了（标题按钮禁用），
   鼠标划过去变绿等于骗用户"这里能点"。 */
#CollapsibleHeader[locked="true"] {
    background-color: @bg_disabled@;
    border-color: @border_disabled@;
}
#CollapsibleHeader[locked="true"]:hover {
    background-color: @bg_disabled@;
    border-color: @border_disabled@;
}
#CollapsibleHeader[locked="true"] QPushButton {
    color: @text_disabled@;
}
#CollapsibleHeader[locked="true"] QPushButton:hover {
    color: @text_disabled@;
}
/* 当前选中的那一组（被锁的都是"没选中的"，两者不会同时出现）。
   描边和副标题用强调色 —— 用户扫一眼就知道"现在装的是它"。 */
#CollapsibleHeader[selected="true"] {
    border-color: @accent@;
}
#CollapsibleHeader[selected="true"] QPushButton {
    color: @accent_text_strong@;
}
#CollapsibleHeader[selected="true"] #CollapsibleHeaderNote {
    color: @accent_text@;
}
/* 折叠组的标题栏（见上面那段），展开出来的**行本身要有一块底色**。
   ⚠️ 这一条按用户的两次反馈改过（方向是反的，别当成"谁改错了"）：
   最早行是"扁平无框"的（用户当时明确要的，理由见上面那段），没设背景图时
   也确实更清爽 —— 但**设了背景图之后行是直接浮在图上的**：文字和图标跟背景
   糊在一起读不清（用户 2026-09 发的截图里一眼就能看到）。
   现在照实验项目的做法给每行一块底色（它那边 `version_card_qss` 就是每行一张卡）。
   底色用比标题栏**暗一级**的页面色，保留"标题是卡、行是列表"的层次。
   ⚠️ 行距也要跟着放大（`CollapsibleGroup` 里 body_box 的 spacing）：扁平行挨着
   排没问题，一块块卡片挨着排就成一大坨了。 */
#CollapsibleBody {
    background-color: transparent;
    border: none;
}
#RemoteVersionRow {
    background-color: @bg_page@;
    border: 1px solid @border@;
    border-radius: 8px;
}
#RemoteVersionRow:hover {
    background-color: @bg_elevated@;
    border-color: @border_control@;
}
/* 用户**已经选中**的那一行（安装选项页里挑加载器版本）。
   ⚠️ 选了哪一行必须能一眼看出来，而且不能只靠悬停色 —— 悬停色鼠标一移开
   就没了，用户会怀疑"我到底选上没有"。所以给个强调色的底 + 边。 */
#RemoteVersionRow[picked="true"] {
    background-color: @accent_bg@;
    border: 1px solid @accent_border@;
    border-radius: 8px;
}
#RemoteVersionRow[picked="true"]:hover {
    background-color: @accent_selected_bg@;
    border-color: @accent@;
}

/* 「网络环境不佳」那页的大感叹号。做得大而醒目，但用警告色而不是
   危险色 —— 网络不通不是用户做错了什么。 */
#NoticeIcon {
    color: @warn@;
    font-size: 52px;
    font-weight: bold;
}

/* 取消下载：平时是普通中性按钮（继承上面的 QPushButton 基础样式），
   悬停才变红。对齐实验那版 —— 直接挂 #DangerButton 的话一上来就是红的，
   在一个"正常下载中"的窗口里太吵。 */
#DownloadCancelButton:hover:enabled {
    border-color: @danger@;
    color: @danger_hover@;
}

/* 加载状态条（「正在获取模组加载器…」那儿的那条）。
   移植自 experiments/Downloading mod test，但颜色用主题变量而不是写死 ——
   那版是 setStyleSheet 里写死 #232428/#5ec269 的，主题一换不跟着变。 */
#LoadingBar {
    background-color: @bg_card@;
    border: 1px solid @border@;
    border-radius: 10px;
}
#LoadingBarText {
    color: @text_secondary@;
    font-size: 12px;
}
#LoadingBarTrack {
    background-color: @bg_control@;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}
#LoadingBarTrack::chunk {
    background-color: @accent_fill@;
    border-radius: 3px;
}

/* 下载 / 安装的进度窗口（布局对齐 experiments/Downloading mod test 里那版：
   左边一列大读数 + 右边文件卡片 + 底部保存路径）。
   ⚠️ 实验那版是把颜色写死在 setStyleSheet 里的 —— 它只跑深色所以没事，
   我们两套主题，所以一律换成主题变量。
   （⚠️ 注释里也别写出那个占位符本身：main_window 会扫全文找漏替换的变量，
   注释里出现一次就会在启动时打一行"有没被替换的变量"的警告。）
   ⚠️ QProgressBar 必须自己写 ::chunk 和槽底色：不写的话 Windows 上会画成
   系统原生的方块条，跟主题完全不是一套东西。 */
#DownloadWindow {
    background-color: @bg_page@;
}
#DownloadTitle {
    color: @text_bright@;
    font-size: 15px;
    font-weight: bold;
}
#DownloadSubtitle, #DownloadFooter {
    color: @text_faint@;
    font-size: 11px;
}
#DownloadCaption {
    color: @text_faint@;
    font-size: 11px;
}
#DownloadValue {
    color: @text@;
    font-size: 17px;
    font-weight: bold;
}
/* 滚动区必须显式透明：不设的话它和 viewport 会露出系统默认的浅灰底，
   在深色窗口里就是一大块刺眼的白（实验那版也踩过这个）。 */
#DownloadScroll, #DownloadScroll > QWidget > QWidget, #DownloadListHost {
    background: transparent;
    border: none;
}
/* 安装器控制台（Forge 那几家装的时候才出现，见 DownloadWindow.stage_begin）。
   ⚠️ QPlainTextEdit 不写这些的话会露出系统白底 + 一条凹陷边框，
   在深色窗口里就是一块刺眼的白。字体用等宽：安装器的输出有对齐的表格。 */
#DownloadConsole {
    background-color: @bg_control@;
    color: @text_faint@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 8px;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
}
#DownloadRow {
    background-color: @bg_card@;
    border: 1px solid @border@;
    border-radius: 8px;
}
#DownloadRow QLabel {
    background-color: transparent;
}
#DownloadRowName {
    color: @text@;
    font-size: 12px;
}
#DownloadRowState {
    color: @text_faint@;
    font-size: 11px;
}
/* 状态色用属性选择器：代码里只 setProperty("kind", ...)，不写死颜色 */
#DownloadRowState[kind="ok"] {
    color: @accent@;
}
#DownloadRowState[kind="err"] {
    color: @danger@;
}
#DownloadRowState[kind="dim"] {
    color: @text_faint@;
}
#DownloadBar, #DownloadBarTotal {
    background-color: @bg_control@;
    border: none;
    border-radius: 3px;
}
#DownloadBar {
    min-height: 6px;
    max-height: 6px;
}
#DownloadBarTotal {
    min-height: 10px;
    max-height: 10px;
}
#DownloadBar::chunk {
    background-color: @accent_fill@;
    border-radius: 3px;
}
#DownloadBarTotal::chunk {
    background-color: @accent_fill@;
    border-radius: 5px;
}
