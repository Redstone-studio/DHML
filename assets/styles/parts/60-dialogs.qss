/* ============================ 对话框 ============================ */

QDialog {
    background-color: @bg_page@;
}

#DialogTitle {
    color: @text_bright@;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 10px;
    border-bottom: 1px solid @border@;
}

QMessageBox {
    background-color: @bg_page@;
}
QMessageBox QLabel {
    color: @text@;
}

