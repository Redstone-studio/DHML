/* ============================ 输入控件 ============================ */

QLineEdit {
    background-color: @bg_control@;
    border: 1px solid @border_control@;
    border-radius: 8px;
    padding: 7px 10px;
    color: @text@;
    selection-background-color: @select_bg@;
    selection-color: @on_accent@;
}
QLineEdit:hover {
    border-color: @border_hover@;
}
QLineEdit:focus {
    border-color: @accent@;
}
QLineEdit:disabled {
    background-color: @bg_disabled@;
    color: @text_faint@;
    border-color: @border_disabled@;
}

/* ---- 数字框：上下箭头用真图标 ---- */
QSpinBox {
    background-color: @bg_control@;
    border: 1px solid @border_control@;
    border-radius: 8px;
    padding: 6px 6px 6px 10px;
    color: @text@;
    min-width: 96px;
    selection-background-color: @select_bg@;
}
QSpinBox:hover {
    border-color: @border_hover@;
}
QSpinBox:focus {
    border-color: @accent@;
}
QSpinBox:disabled {
    background-color: @bg_disabled@;
    color: @text_faint@;
    border-color: @border_disabled@;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    margin: 2px 3px 0 0;
    border: none;
    background: transparent;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    margin: 0 3px 2px 0;
    border: none;
    background: transparent;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: @border_control@;
    border-radius: 4px;
}
QSpinBox::up-arrow {
    image: url(@ICONS@/chevron-up.svg);
    width: 11px;
    height: 11px;
}
QSpinBox::down-arrow {
    image: url(@ICONS@/chevron-down.svg);
    width: 11px;
    height: 11px;
}

/* ---- 下拉框 ---- */
QComboBox {
    background-color: @bg_control@;
    border: 1px solid @border_control@;
    border-radius: 8px;
    padding: 7px 10px;
    color: @text@;
    min-height: 20px;
}
QComboBox:hover {
    border-color: @border_hover@;
}
QComboBox:focus {
    border-color: @accent@;
}
QComboBox:disabled {
    background-color: @bg_disabled@;
    color: @text_faint@;
    border-color: @border_disabled@;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(@ICONS@/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: @bg_elevated@;
    border: 1px solid @border_control@;
    border-radius: 8px;
    padding: 4px;
    color: @text@;
    outline: none;
    selection-background-color: @accent_selected_bg@;
    selection-color: @accent_text_strong@;
}
QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 6px;
    min-height: 22px;
}
QComboBox QAbstractItemView::separator {
    height: 1px;
    background-color: @border_control@;
    margin: 4px 6px;
}

/* ---- 勾选框 / 单选框：统一成 PCL2 那种打勾样式 ---- */
QCheckBox {
    color: @text_secondary@;
    spacing: 9px;
    padding: 3px;
}
QCheckBox:hover {
    color: @text_bright@;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border-radius: 4px;
    border: 1px solid @border_hover@;
    background-color: @bg_check@;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: @accent@;
}
QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: @accent_fill@;
    border-color: @accent@;
    image: url(@ICONS@/check.svg);
}
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border-color: @border_disabled@;
    background-color: @bg_disabled@;
}

QRadioButton {
    color: @text_secondary@;
    spacing: 9px;
    padding: 9px 11px;
    border: 1px solid transparent;
    border-radius: 8px;
}
QRadioButton:hover {
    background-color: @bg_elevated@;
}
QRadioButton:checked {
    background-color: @accent_bg@;
    border-color: @accent_border@;
    color: @accent_text_strong@;
    font-weight: bold;
}
QRadioButton:disabled {
    color: @text_disabled@;
}

/* ============================ 列表 / 表格 ============================ */

QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    color: @text_secondary@;
}
QListWidget::item {
    padding: 9px 10px;
    border-radius: 8px;
    margin-bottom: 2px;
}
QListWidget::item:hover {
    background-color: @bg_elevated@;
}
QListWidget::item:selected {
    background-color: @bg_elevated@;
    color: @accent@;
}

QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    outline: none;
    color: @text_secondary@;
    selection-background-color: @bg_elevated@;
    selection-color: @accent@;
}
QTableWidget::item {
    padding: 7px 8px;
    border: none;
}
QTableWidget::item:hover {
    background-color: @bg_card@;
}
QTableWidget::item:selected {
    background-color: @bg_elevated@;
    color: @accent@;
}

QHeaderView::section {
    background-color: transparent;
    color: @text_faint@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 8px;
    font-size: 12px;
    font-weight: bold;
}
QTableCornerButton::section {
    background-color: transparent;
    border: none;
}

/* ============================ 滚动条 ============================
   ⚠️ 这里是**全局**的：搜索结果、版本列表、详情页版本分组、设置页、日志窗口
   全都用这一份。改它会一次性影响所有滚动区。

   箭头按钮（add-line / sub-line）原来是 `height: 0; width: 0` —— 也就是
   刻意做成"没有箭头"的极简滚动条。2026-09 用户要求**把上下箭头显出来**
   （"顶满的宽度还是没有 ↑ ↓ 按钮"），所以恢复了按钮并给它配了 SVG 箭头。

   ⚠️ 用 `@ICONS_SUFFIX@` 而不是死写文件名：Qt 的 SVG **不支持 currentColor**，
   箭头颜色只能写死在文件里，深色底和浅色底需要不同灰度，所以有
   `chevron-up.svg` / `chevron-up-light.svg` 两份（同 ui/icons.py 的约定）。
   这个后缀由 ui/main_window.py 按当前主题替换，主题一变它会重跑。 */

QScrollBar:vertical {
    background: transparent;
    /* ⚠️ 保持 10px —— 加箭头**不能**靠加宽滚动条：宽了就会把内容挤窄
       （用户 2026-09 报「导航项变窄了」就是这么来的）。
       箭头按钮做成 10px 见方，正好塞进原来的宽度里。 */
    width: 10px;
    margin: 2px 0 2px 0;
}
QScrollBar::handle:vertical {
    background-color: @border_control@;
    border-radius: 5px;
    min-height: 30px;
    /* 左右各留 2px：handle 比轨道窄一点，两边能看到轨道底色，
       而且宽度正好跟上下按钮对齐 */
    margin: 0 2px 0 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: @border_hover@;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 0 2px;
}
QScrollBar::handle:horizontal {
    background-color: @border_control@;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px 0 2px 0;
}
QScrollBar::handle:horizontal:hover {
    background-color: @border_hover@;
}

/* 上下 / 左右那两个箭头按钮。
   ⚠️ 尺寸必须 ≤ 滚动条宽度（10px），否则 Qt 会把滚动条自身撑宽、把内容挤窄。
   16px 高是给纵向按钮的，宽度交给滚动条自己定（= 10px）。 */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    border: none;
    height: 16px;
    subcontrol-origin: margin;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: transparent;
    border: none;
    width: 16px;
    subcontrol-origin: margin;
}
/* 悬停时给按钮一块淡底，让"这里能点"看得见 */
QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:horizontal:hover, QScrollBar::sub-line:horizontal:hover {
    background-color: @bg_elevated@;
    border-radius: 4px;
}
/* 箭头图标。⚠️ 8px 是调出来的：SVG 本身是 12×12，按 10px 渲染会顶到滚动条
   两边（滚动条只有 10px 宽），看着像被切掉；8px 时形态完整、留白也舒服。 */
QScrollBar::up-arrow:vertical {
    image: url(@ICONS@/chevron-up@ICONS_SUFFIX@.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::down-arrow:vertical {
    image: url(@ICONS@/chevron-down@ICONS_SUFFIX@.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::left-arrow:horizontal {
    image: url(@ICONS@/chevron-up@ICONS_SUFFIX@.svg);
    width: 8px;
    height: 8px;
}
QScrollBar::right-arrow:horizontal {
    image: url(@ICONS@/chevron-down@ICONS_SUFFIX@.svg);
    width: 8px;
    height: 8px;
}
/* 禁用态：滚不动的时候箭头淡一点，别看着像能点 */
QScrollBar::up-arrow:vertical:disabled, QScrollBar::down-arrow:vertical:disabled,
QScrollBar::left-arrow:horizontal:disabled,
QScrollBar::right-arrow:horizontal:disabled {
    image: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

